/cmake-build-*/
/cmake-install-*/
/build/
/out/

# CMake user config
/CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/

# vcpkg (installed to short paths outside the tree by scripts/install-deps.bat)
/vcpkg_installed/

# Tooling / IDE
/.idea/
/.vs/
/.vscode/
/ccache/
*.user

# Local databases
user-history.db
symbology-style.db

# Release packaging output (produced by CI/packaging, not source)
/release-pkg/
/*.zip

# Linux: locally fetched CMake when the distro ships one older than 4.3
/.toolchain/

# Vendored FetchContent dependencies (scripts/fetch-deps.*) - a local cache
# that makes configure work offline, not part of this repository.
/helper/
/arinc-649/
/arinc_665/
/tftp/
/commands/

# Python
__pycache__/
*.py[cod]

# Regenerated on every docs/code-trace-docx build
/docs/code-trace-docx/arinc615a-cli-engineering.figured.html

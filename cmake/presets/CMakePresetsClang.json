{
  "version": 10,

  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "cmake-build-${presetName}",
      "installDir": "cmake-install-${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "True"
      }
    },
    {
      "name": "clang-static-debug",
      "displayName": "Clang Static Debug",
      "description": "Clang Static Debug",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-static-release",
      "displayName": "Clang Static Release",
      "description": "Clang Static Release",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-shared-debug",
      "displayName": "Clang Shared Debug",
      "description": "Clang Shared Debug",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": true
      }
    },
    {
      "name": "clang-shared-release",
      "displayName": "Clang Shared Release",
      "description": "Clang Shared Release",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": true
      }
    }
  ],

  "buildPresets": [
    {
      "name": "clang-static-debug",
      "displayName": "Clang Static Debug Build",
      "configurePreset": "clang-static-debug"
    },
    {
      "name": "clang-static-debug-with-doc",
      "displayName": "Clang Static Debug Build including Documentation",
      "configurePreset": "clang-static-debug",
      "targets": [ "all", "doc" ]
    },
    {
      "name": "clang-static-release",
      "displayName": "Clang Static Release Build",
      "configurePreset": "clang-static-release"
    },
    {
      "name": "clang-static-release-with-doc",
      "displayName": "Clang Static Release Build including Documentation",
      "configurePreset": "clang-static-release",
      "targets": [ "all", "doc" ]
    },
    {
      "name": "clang-shared-debug",
      "displayName": "Clang Shared Debug Build",
      "configurePreset": "clang-shared-debug"
    },
    {
      "name": "clang-shared-debug-with-doc",
      "displayName": "Clang Shared Debug Build including Documentation",
      "configurePreset": "clang-shared-debug",
      "targets": [ "all", "doc" ]
    },
    {
      "name": "clang-shared-release",
      "displayName": "Clang Shared Release Build",
      "configurePreset": "clang-shared-release"
    },
    {
      "name": "clang-shared-release-with-doc",
      "displayName": "Clang Shared Release Build including Documentation",
      "configurePreset": "clang-shared-release",
      "targets": [ "all", "doc" ]
    }
  ],

  "testPresets": [
    {
      "name": "clang-static-debug",
      "displayName": "Clang Static Debug Tests",
      "configurePreset": "clang-static-debug",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    },
    {
      "name": "clang-static-release",
      "displayName": "Clang Static Release Tests",
      "configurePreset": "clang-static-release",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    },
    {
      "name": "clang-shared-debug",
      "displayName": "Clang Shared Debug Tests",
      "configurePreset": "clang-shared-debug",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    },
    {
      "name": "clang-shared-release",
      "displayName": "Clang Shared Release Tests",
      "configurePreset": "clang-shared-release",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    }
  ],

  "packagePresets": [
    {
      "name": "clang-static-debug",
      "displayName": "Clang Static Debug Packaging",
      "configurePreset": "clang-static-debug"
    },
    {
      "name": "clang-static-release",
      "displayName": "Clang Static Release Packaging",
      "configurePreset": "clang-static-release"
    },
    {
      "name": "clang-shared-debug",
      "displayName": "Clang Shared Debug Packaging",
      "configurePreset": "clang-shared-debug"
    },
    {
      "name": "clang-shared-release",
      "displayName": "Clang Shared Release Packaging",
      "configurePreset": "clang-shared-release"
    }
  ],

  "workflowPresets": [
    {
      "name": "clang-static-debug",
      "displayName": "Clang Static Debug Workflow",
      "description": "Build, test and package Clang Static Debug Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "clang-static-debug"
        },
        {
          "type": "build",
          "name": "clang-static-debug-with-doc"
        },
        {
          "type": "test",
          "name": "clang-static-debug"
        },
        {
          "type": "package",
          "name": "clang-static-debug"
        }
      ]
    },
    {
      "name": "clang-static-release",
      "displayName": "Clang Static Release Workflow",
      "description": "Build, test and package Clang Static Release Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "clang-static-release"
        },
        {
          "type": "build",
          "name": "clang-static-release-with-doc"
        },
        {
          "type": "test",
          "name": "clang-static-release"
        },
        {
          "type": "package",
          "name": "clang-static-release"
        }
      ]
    },
    {
      "name": "clang-shared-debug",
      "displayName": "Clang Shared Debug Workflow",
      "description": "Build, test and package Clang Shared Debug Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "clang-shared-debug"
        },
        {
          "type": "build",
          "name": "clang-shared-debug-with-doc"
        },
        {
          "type": "test",
          "name": "clang-shared-debug"
        },
        {
          "type": "package",
          "name": "clang-shared-debug"
        }
      ]
    },
    {
      "name": "clang-shared-release",
      "displayName": "Clang Shared Release Workflow",
      "description": "Build, test and package Clang Shared Release Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "clang-shared-release"
        },
        {
          "type": "build",
          "name": "clang-shared-release-with-doc"
        },
        {
          "type": "test",
          "name": "clang-shared-release"
        },
        {
          "type": "package",
          "name": "clang-shared-release"
        }
      ]
    }
  ]
}

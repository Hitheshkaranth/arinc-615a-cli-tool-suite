{
  "version": 10,

  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "cmake-build-${presetName}",
      "installDir": "cmake-install-${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": "True",
        "VCPKG_APPLOCAL_DEPS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      }
    },
    {
      "name": "msvc-static-debug",
      "displayName": "MSVC Static Debug",
      "description": "MSVC Static Debug",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-static-release",
      "displayName": "MSVC Static Release",
      "description": "MSVC Static Release",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msvc-shared-debug",
      "displayName": "MSVC Shared Debug",
      "description": "MSVC Shared Debug",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_SHARED_LIBS": true
      }
    },
    {
      "name": "msvc-shared-release",
      "displayName": "MSVC Shared Release",
      "description": "MSVC Shared Release",
      "inherits": "msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": true
      }
    }
  ],

  "buildPresets": [
    {
      "name": "msvc-static-debug",
      "displayName": "MSVC Static Debug Build",
      "configurePreset": "msvc-static-debug"
    },
    {
      "name": "msvc-static-debug-with-doc",
      "displayName": "MSVC Static Debug Build including Documentation",
      "configurePreset": "msvc-static-debug",
      "targets": [ "all", "doc" ]
    },
    {
      "name": "msvc-static-release",
      "displayName": "MSVC Static Release Build",
      "configurePreset": "msvc-static-release"
    },
    {
      "name": "msvc-static-release-with-doc",
      "displayName": "MSVC Static Release Build including Documentation",
      "configurePreset": "msvc-static-release",
      "targets": [ "all", "doc" ]
    },
    {
      "name": "msvc-shared-debug",
      "displayName": "MSVC Shared Debug Build",
      "configurePreset": "msvc-shared-debug"
    },
    {
      "name": "msvc-shared-debug-with-doc",
      "displayName": "MSVC Shared Debug Build including Documentation",
      "configurePreset": "msvc-shared-debug",
      "targets": [ "all", "doc" ]
    },
    {
      "name": "msvc-shared-release",
      "displayName": "MSVC Shared Release Build",
      "configurePreset": "msvc-shared-release"
    },
    {
      "name": "msvc-shared-release-with-doc",
      "displayName": "MSVC Shared Release Build including Documentation",
      "configurePreset": "msvc-shared-release",
      "targets": [ "all", "doc" ]
    }
  ],

  "testPresets": [
    {
      "name": "msvc-static-debug",
      "displayName": "MSVC Static Debug Tests",
      "configurePreset": "msvc-static-debug",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    },
    {
      "name": "msvc-static-release",
      "displayName": "MSVC Static Release Tests",
      "configurePreset": "msvc-static-release",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    },
    {
      "name": "msvc-shared-debug",
      "displayName": "MSVC Shared Debug Tests",
      "configurePreset": "msvc-shared-debug",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    },
    {
      "name": "msvc-shared-release",
      "displayName": "MSVC Shared Release Tests",
      "configurePreset": "msvc-shared-release",
      "output": {
        "outputJUnitFile": "test-log.junit.xml"
      }
    }
  ],

  "packagePresets": [
    {
      "name": "msvc-static-debug",
      "displayName": "MSVC Static Debug Packaging",
      "configurePreset": "msvc-static-debug"
    },
    {
      "name": "msvc-static-release",
      "displayName": "MSVC Static Release Packaging",
      "configurePreset": "msvc-static-release"
    },
    {
      "name": "msvc-shared-debug",
      "displayName": "MSVC Shared Debug Packaging",
      "configurePreset": "msvc-shared-debug"
    },
    {
      "name": "msvc-shared-release",
      "displayName": "MSVC Shared Release Packaging",
      "configurePreset": "msvc-shared-release"
    }
  ],

  "workflowPresets": [
    {
      "name": "msvc-static-debug",
      "displayName": "MSVC Static Debug Workflow",
      "description": "Build, test and package MSVC Static Debug Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-static-debug"
        },
        {
          "type": "build",
          "name": "msvc-static-debug-with-doc"
        },
        {
          "type": "test",
          "name": "msvc-static-debug"
        },
        {
          "type": "package",
          "name": "msvc-static-debug"
        }
      ]
    },
    {
      "name": "msvc-static-release",
      "displayName": "MSVC Static Release Workflow",
      "description": "Build, test and package MSVC Static Release Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-static-release"
        },
        {
          "type": "build",
          "name": "msvc-static-release-with-doc"
        },
        {
          "type": "test",
          "name": "msvc-static-release"
        },
        {
          "type": "package",
          "name": "msvc-static-release"
        }
      ]
    },
    {
      "name": "msvc-shared-debug",
      "displayName": "MSVC Shared Debug Workflow",
      "description": "Build, test and package MSVC Shared Debug Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-shared-debug"
        },
        {
          "type": "build",
          "name": "msvc-shared-debug-with-doc"
        },
        {
          "type": "test",
          "name": "msvc-shared-debug"
        },
        {
          "type": "package",
          "name": "msvc-shared-debug"
        }
      ]
    },
    {
      "name": "msvc-shared-release",
      "displayName": "MSVC Shared Release Workflow",
      "description": "Build, test and package MSVC Shared Release Configuration",
      "steps": [
        {
          "type": "configure",
          "name": "msvc-shared-release"
        },
        {
          "type": "build",
          "name": "msvc-shared-release-with-doc"
        },
        {
          "type": "test",
          "name": "msvc-shared-release"
        },
        {
          "type": "package",
          "name": "msvc-shared-release"
        }
      ]
    }
  ]
}
